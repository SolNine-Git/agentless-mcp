  {"name": "complexity_ruby/sample.rb", "source": "class Router\n  def route(kind, flag)\n    # A comment line does not count.\n\n    _label = \"one\ntwo\nthree\"\n    if kind == :a && flag\n      1\n    elsif kind == :b || flag\n      2\n    else\n      3\n    end\n  end\n\n  def classify(v)\n    result = case v\n             when 1, 2 then :low\n             when 3 then :mid\n             else :high\n             end\n    label = v > 0 ? \"pos\" : \"neg\"\n    log(label) unless v.zero?\n    result\n  rescue ArgumentError\n    nil\n  end\n\n  def self.pick(value)\n    case value\n    in [x] if x > 0 then x\n    in { name: } unless name.nil? then name\n    in _ then nil\n    end\n  end\n\n  def drain(items)\n    items.each { |i| puts i if i.positive? }\n    i = 0\n    i += 1 while i < 10 and items.any?\n    until i.zero?\n      i -= 1\n    end\n    for x in items do puts x end\n    Integer(items.first) rescue 0\n  end\nend\n", "symbols": [{"name": "Router", "kind": "class", "line": 1, "end_line": 48, "name_line": 1, "signature": "class Router", "parent": "", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "rb:complexity_ruby/sample.rb::Router", "rationales": []}, {"name": "route", "kind": "method", "line": 2, "end_line": 15, "name_line": 2, "signature": "fn route(kind, flag)", "parent": "Router", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "rb:complexity_ruby/sample.rb::Router.route", "rationales": []}, {"name": "classify", "kind": "method", "line": 17, "end_line": 28, "name_line": 17, "signature": "fn classify(v)", "parent": "Router", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "rb:complexity_ruby/sample.rb::Router.classify", "rationales": []}, {"name": "pick", "kind": "method", "line": 30, "end_line": 36, "name_line": 30, "signature": "fn pick(value)", "parent": "Router", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "rb:complex