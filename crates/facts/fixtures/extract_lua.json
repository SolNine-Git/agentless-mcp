  {"name": "complexity_lua/sample.lua", "source": "local M = {}\n\nlocal function clamp(v, lo, hi)\n  -- A comment line does not count.\n\n  local label = [[one\ntwo\nthree]]\n  if v < lo then\n    return lo\n  elseif v > hi then\n    return hi\n  end\n  return v\nend\n\nfunction M.pick(xs, flag)\n  local best = flag and xs[1] or nil\n  for i = 1, #xs do\n    while xs[i] == nil do\n      i = i + 1\n    end\n  end\n  for _, v in ipairs(xs) do\n    repeat\n      v = v - 1\n    until v <= 0 or flag\n  end\n  return best\nend\n\nM.handler = function(ev)\n  return ev and ev.ok\nend\n\nlocal a, b = function() return 1 end, 2\n\nreturn M\n", "symbols": [{"name": "M", "kind": "class", "line": 1, "end_line": 1, "name_line": 1, "signature": "local M = {}", "parent": "", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "lua:complexity_lua/sample.lua::M", "rationales": []}, {"name": "clamp", "kind": "function", "line": 3, "end_line": 15, "name_line": 3, "signature": "fn clamp", "parent": "", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "lua:complexity_lua/sample.lua::clamp", "rationales": []}, {"name": "M.pick", "kind": "function", "line": 17, "end_line": 30, "name_line": 17, "signature": "fn M.pick", "parent": "", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "lua:complexity_lua/sample.lua::M.pick", "rationales": []}, {"name": "M.handler", "kind": "function", "line": 32, "end_line": 34, "name_line": 32, "signature": "fn M.handler(ev)", "parent": "", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "lua:complexity_lua/sample.lua::M.handler", "rationales": []}, {"name": "a", "kind": "function", "line": 36, "end_line": 36, "name_line": 36, "signature": "local fn a()", "parent": "", "decorated": false, "bases": [], "is_public": true, "duplicate_index": 0, "id": "lua:complexity_lua/sample.lua::a", "rationales": []}], "imports": [], "refs": [["M", 1, "re