 {"name": "sample.rb", "source": "class Router\n  def route(kind, flag)\n    # A comment line does not count.\n\n    _label = \"one\ntwo\nthree\"\n    if kind == :a && flag\n      1\n    elsif kind == :b || flag\n      2\n    else\n      3\n    end\n  end\n\n  def classify(v)\n    result = case v\n             when 1, 2 then :low\n             when 3 then :mid\n             else :high\n             end\n    label = v > 0 ? \"pos\" : \"neg\"\n    log(label) unless v.zero?\n    result\n  rescue ArgumentError\n    nil\n  end\n\n  def self.pick(value)\n    case value\n    in [x] if x > 0 then x\n    in { name: } unless name.nil? then name\n    in _ then nil\n    end\n  end\n\n  def drain(items)\n    items.each { |i| puts i if i.positive? }\n    i = 0\n    i += 1 while i < 10 and items.any?\n    until i.zero?\n      i -= 1\n    end\n    for x in items do puts x end\n    Integer(items.first) rescue 0\n  end\nend\n", "units": [{"qualname": "Router.route", "start_byte": 15, "end_byte": 205, "start_line": 2, "body_key": "37971c060d5f12a130306df19b444512c1e4af869a0a83cc72c666ad7501ce5a", "cc": 5, "sloc": 11}, {"qualname": "Router.classify", "start_byte": 209, "end_byte": 460, "start_line": 17, "body_key": "f391a429eccd857496a449462d5d491e708139f261832c11dc1703f7ce213324", "cc": 6, "sloc": 12}, {"qualname": "Router.pick", "start_byte": 464, "end_byte": 602, "start_line": 30, "body_key": "db08557490967770d0615b264ba9ea396f0dbf9ea96ae5f9494c4a7194d8850f", "cc": 5, "sloc": 7}, {"qualname": "Router.drain", "start_byte": 606, "end_byte": 828, "start_line": 38, "body_key": "60ebd8ce44704a38837c9fec3a072c960c1a456e4499f78f62e6cebc0d518e1e", "cc": 7, "sloc": 10}], "blocks": [{"start_line": 2, "end_line": 15, "key": "a48558c422f571ed78687e649cef8c791e41c366f2dd2a7d07ed6d2b83c45aee", "exact": "9ba5ff52b94b2d8072bf7a70267ac7c6ac026bff1225e2b012afdd9f8db29ff9", "function": true, "tokens": 28}, {"start_line": 8, "end_line": 14, "key": "d64293ff6ef5127ff6ebc36f17fd0efe3006a2f2a8bf9d277fccd2