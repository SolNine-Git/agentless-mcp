 {"name": "branches.py", "source": "\"\"\"Branch, loop, comprehension, and match counting.\"\"\"\n\nimport sys\n\n\ndef route(kind, flag):\n    if kind == \"a\" and flag:\n        return 1\n    elif kind == \"b\" or not flag:\n        return 2\n    elif kind == \"c\":\n        return 3\n    else:\n        return 4\n\n\ndef loops(items):\n    for item in items:\n        if item:\n            break\n    else:\n        return None\n    while items:\n        items.pop()\n    else:\n        pass\n    assert items is not None, \"items\"\n    return 0 if items else 1\n\n\ndef handle(job):\n    try:\n        job.run()\n    except (ValueError, KeyError):\n        return 1\n    except OSError as exc:\n        job.log(exc)\n    else:\n        return 3\n    finally:\n        job.close()\n    try:\n        job.retry()\n    except* RuntimeError:\n        job.log(\"group\")\n\n\ndef shapes(rows, flag):\n    evens = [r for r in rows if r % 2 == 0 if r]\n    pairs = {r: c for r in rows for c in r if c}\n    unique = {r for r in rows}\n    total = sum(r for r in rows if flag or r)\n    return evens, pairs, unique, total\n\n\ndef dispatch(command):\n    match command:\n        case [\"go\", where] if where:\n            return where\n        case [\"stop\"] | [\"halt\"]:\n            return None\n        case {\"k\": value} if value and command:\n            return value\n        case _:\n            return lambda x: x if x else None\n\n\ndef busy(a, b, c, d):\n    if a:\n        if b and c:\n            return 1\n        elif c or d:\n            return 2\n    for x in a:\n        while x and b:\n            x -= 1\n    result = [y for y in b if y] or [z for z in c if z and d]\n    try:\n        return result if result else None\n    except Exception:\n        return None\n\n\nidentity = lambda v: v if v else None\n\nif sys.version_info >= (3, 12):\n    pass\n", "units": [{"qualname": "route", "start_byte": 69, "end_byte": 254, "start_line": 6, "body_key": "ecf7cd0150f41845cc8d0f5f6b