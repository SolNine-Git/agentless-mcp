 {"name": "nesting.py", "source": "\"\"\"Nesting, classes, decorators, async, and definitions scb-check does not visit.\"\"\"\n\nimport functools\nfrom typing import TYPE_CHECKING\n\n\ndef outer(items):\n    def inner(x):\n        if x:\n            return [y for y in x if y]\n        return []\n\n    class Local:\n        def method(self, v):\n            return v or None\n\n    if items:\n        def hidden(z):\n            return z and items\n        return hidden\n    return inner\n\n\nclass Service:\n    \"\"\"Service docstring.\"\"\"\n\n    class Nested:\n        def deep(self, a, b):\n            return a if a else b\n\n    @staticmethod\n    def build(flag):\n        while flag:\n            flag = False\n        return flag\n\n    @functools.cache\n    async def fetch(self, key):\n        async for row in self.rows(key):\n            if row:\n                return row\n        return None\n\n    async def rows(self, key):\n        yield key\n\n\n@functools.wraps(outer)\ndef wrapped(*args):\n    return outer(*args) or ()\n\n\nif TYPE_CHECKING:\n    def typed_only(value):\n        if value:\n            return value\n        return None\n\ntry:\n    def guarded(value):\n        return value and True\nexcept ImportError:\n    guarded = None\n\nif __name__ == \"__main__\":\n    def main():\n        return 0 if outer([]) else 1\n", "units": [{"qualname": "outer", "start_byte": 138, "end_byte": 428, "start_line": 7, "body_key": "5b3cae8fa5f045c2ffad2c7ef3f72c8f79ff6d34482ded7e27e29add6160b1a6", "cc": 7, "sloc": 13}, {"qualname": "outer.inner", "start_byte": 160, "end_byte": 244, "start_line": 8, "body_key": "fdb749f7acf42dc8eeedc979df1050de6b47db488e2c1cec15689489f59997bc", "cc": 4, "sloc": 4}, {"qualname": "outer.Local.method", "start_byte": 271, "end_byte": 320, "start_line": 14, "body_key": "013fac4047b714b7f61e8bc96065e8c4ed9a9a5992a7bfe4512541e6f5dfbbd9", "cc": 2, "sloc": 2}, {"qualname": "Service.Nested.deep", "start_byte": 502, "end_byte": 556, "start_lin