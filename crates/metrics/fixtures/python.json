 {"name": "clones.py", "source": "\"\"\"Type-1 and Type-2 clones, with the clone-normalization quirks.\"\"\"\n\nfrom typing import TYPE_CHECKING\n\n\ndef total_a(items):\n    \"\"\"Sum the items.\"\"\"  # trailing comment\n    total = 0\n    for item in items:\n        total += item\n    return total\n\n\ndef total_b(values):\n    total = 0\n    for value in values:\n        total += value\n    return total\n\n\ndef scale_a(rows):\n    out = []\n    for row in rows:\n        out.append(row * 2)\n    return out\n\n\ndef scale_b(cols):\n    acc = []\n    for col in cols:\n        acc.append(col * 3)\n    return acc\n\n\ndef first(data):\n    for entry in data:\n        if entry:\n            yield entry\n\n\ndef second(data):\n    for entry in data:\n        if entry:\n            yield entry\n\n\nif TYPE_CHECKING:\n    def typed_a(items):\n        if items:\n            return items\n        return None\n\n\ndef typed_b(values):\n    if values:\n        return values\n    return None\n", "units": [{"qualname": "total_a", "start_byte": 105, "end_byte": 245, "start_line": 6, "body_key": "ef8054806d54a6cdb5090f57c9afddc7cdaca31b4834ac635e092714c648c009", "cc": 2, "sloc": 6}, {"qualname": "total_b", "start_byte": 248, "end_byte": 347, "start_line": 14, "body_key": "ac2fb230e342bcac770684963e9c60f6faab3fd799a4f8c7b26ae5f74b2d1ca1", "cc": 2, "sloc": 5}, {"qualname": "scale_a", "start_byte": 350, "end_byte": 445, "start_line": 21, "body_key": "678d4bd1405335f70ddb4665916af6bcad72b481f22fc9524f382a2e73b7af59", "cc": 2, "sloc": 5}, {"qualname": "scale_b", "start_byte": 448, "end_byte": 543, "start_line": 28, "body_key": "c70943aae074cc2ed140bbb8e23ee92d1a628017a9d500a8c1dfc25b457754d1", "cc": 2, "sloc": 5}, {"qualname": "first", "start_byte": 546, "end_byte": 627, "start_line": 35, "body_key": "0d770c6c8b4a8bdeacdd977ef83dc427d8246ff0202a823ad0c32f15bf99ecc8", "cc": 3, "sloc": 4}, {"qualname": "second", "start_byte": 630, "end_byte": 712, "start_line": 41, "body_key": "0d770c