 {"name": "sample.rs", "source": "struct Parser {\n    pos: usize,\n}\n\nimpl Parser {\n    fn next(&mut self, v: Option<i32>, flag: bool) -> i32 {\n        // A comment line does not count.\n\n        let _label = \"one\ntwo\nthree\";\n        if let Some(x) = v && (flag || self.pos > 3) {\n            return x;\n        }\n        match v {\n            Some(n) if n > 10 => n,\n            Some(0) => 0,\n            _ => -1,\n        }\n    }\n\n    fn drain(&mut self) {\n        let step = |p: usize| if p > 0 { p - 1 } else { 0 };\n        while self.pos > 0 {\n            self.pos = step(self.pos);\n        }\n        loop {\n            if self.pos == 0 {\n                break;\n            }\n        }\n        for _ in 0..3 {}\n    }\n}\n\nfn outer() -> i32 {\n    fn inner(a: bool) -> i32 {\n        if a { 1 } else { 2 }\n    }\n    inner(true) + inner(false)\n}\n", "units": [{"qualname": "Parser.next", "start_byte": 53, "end_byte": 393, "start_line": 6, "body_key": "c085dac65943c08abd35d8529c2e445d6736a743105d6f7bded0135036b624a8", "cc": 7, "sloc": 12}, {"qualname": "Parser.drain", "start_byte": 399, "end_byte": 683, "start_line": 22, "body_key": "375743ffcea18ba4a74703133005d60b26f966bf4ccfaec8dcf48b65d35edd48", "cc": 5, "sloc": 12}, {"qualname": "outer", "start_byte": 687, "end_byte": 806, "start_line": 36, "body_key": "c166157538b444b129843498966adeb5573b53f5402223fe1bcbede71c8eb844", "cc": 2, "sloc": 6}, {"qualname": "outer.inner", "start_byte": 711, "end_byte": 773, "start_line": 37, "body_key": "6ce56dbe5dad03e10de79e6e642ba9b5991c9f6184f3b938ff4329c3281b30ed", "cc": 2, "sloc": 3}], "blocks": [{"start_line": 6, "end_line": 20, "key": "0a94456e4b88d959a5e2c76c6e265eab40023b13850d6e291bbb042d85ccc306", "exact": "3308caed74291ca49c88f6ccbb598376ea457fe406aa236a45a0a778346726d9", "function": true, "tokens": 77}, {"start_line": 12, "end_line": 14, "key": "44475fab6bee0b3568a4953cda9a3332edd1c0f27be2ee0da2fcdbebacc0e92a", "exact": "d5fc45f074638f47cb4cc1e84