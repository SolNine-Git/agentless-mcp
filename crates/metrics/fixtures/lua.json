 {"name": "sample.lua", "source": "local M = {}\n\nlocal function clamp(v, lo, hi)\n  -- A comment line does not count.\n\n  local label = [[one\ntwo\nthree]]\n  if v < lo then\n    return lo\n  elseif v > hi then\n    return hi\n  end\n  return v\nend\n\nfunction M.pick(xs, flag)\n  local best = flag and xs[1] or nil\n  for i = 1, #xs do\n    while xs[i] == nil do\n      i = i + 1\n    end\n  end\n  for _, v in ipairs(xs) do\n    repeat\n      v = v - 1\n    until v <= 0 or flag\n  end\n  return best\nend\n\nM.handler = function(ev)\n  return ev and ev.ok\nend\n\nlocal a, b = function() return 1 end, 2\n\nreturn M\n", "units": [{"qualname": "clamp", "start_byte": 14, "end_byte": 203, "start_line": 3, "body_key": "74dd0ae336366026356334935b5b9c7697c31471ae84411c26932f26b4356599", "cc": 3, "sloc": 10}, {"qualname": "M.pick", "start_byte": 205, "end_byte": 447, "start_line": 17, "body_key": "5cb7467620bf941e833863c24cd918cb456d7ad20ffacce19540b0c1a9ed05d8", "cc": 8, "sloc": 14}, {"qualname": "M.handler", "start_byte": 461, "end_byte": 499, "start_line": 32, "body_key": "769e10cd1d5d1fbc77a6cb5a5a08bb04d9aba8aec7803a0f151eb9cba553fdee", "cc": 2, "sloc": 3}], "blocks": [{"start_line": 3, "end_line": 15, "key": "9eab816873e6197c5843fac36b4f198a945ffbd65dbebe0492a84837800bb5a2", "exact": "d4f56c5174cfd2ebe31cd77c86b899779ef764d08f5607dccaa4373590a9830f", "function": true, "tokens": 32}, {"start_line": 9, "end_line": 13, "key": "0dc5c3e84458494555081494c1b75b2fa0557f362716e6a1cb7bd56a1bfefbf0", "exact": "9995bc8ad84232db9974cebe43a5826f947589e51844072c57893dcc40ccac3d", "function": false, "tokens": 15}, {"start_line": 17, "end_line": 30, "key": "cc1938041f01afbf07dcaed761b6f8f0ffa851f78ded628b4891565e8020de23", "exact": "c2f8d1b3e2fdc50b98a3f21922bd48f4c6598c7c8cfe28b5ad67fc5ad6b72d3d", "function": true, "tokens": 69}, {"start_line": 19, "end_line": 23, "key": "87a59a720519ff5737d29751705ec147bed4f92468b1a02ab7b4366f9d4cd0e3", "exact": "c231da869901328e51399b5f4e49a2e4fdda