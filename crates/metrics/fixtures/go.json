 {"name": "sample.go", "source": "package sample\n\ntype Store struct{ items []int }\n\nfunc (s *Store) Find(key int) int {\n\t// A comment line does not count.\n\n\tlabel := `one\ntwo\nthree`\n\t_ = label\n\tfor i, v := range s.items {\n\t\tif v == key && i > 0 || key < 0 {\n\t\t\treturn i\n\t\t}\n\t}\n\tswitch key {\n\tcase 1, 2:\n\t\treturn 1\n\tcase 3:\n\t\treturn 3\n\tdefault:\n\t\treturn 0\n\t}\n}\n\nfunc Classify(v interface{}) string {\n\tcheck := func(x int) bool { return x > 0 && x < 10 }\n\tswitch t := v.(type) {\n\tcase int:\n\t\tif check(t) {\n\t\t\treturn \"small\"\n\t\t}\n\tcase string:\n\t\treturn t\n\t}\n\tselect {\n\tdefault:\n\t}\n\treturn \"\"\n}\n", "units": [{"qualname": "Store.Find", "start_byte": 50, "end_byte": 325, "start_line": 5, "body_key": "12aca9955588a79da37f774837b664e56b9b97938e6197a17a6c37ac2ff21dc3", "cc": 7, "sloc": 18}, {"qualname": "Classify", "start_byte": 327, "end_byte": 555, "start_line": 27, "body_key": "60fdcb142e25baf7fb48ecce70196769441df6317c0bd4ff654568a39846113b", "cc": 5, "sloc": 15}], "blocks": [{"start_line": 5, "end_line": 25, "key": "fd7e2ac8f785b387c598785f7dc953ebef900402f82392d61a9df1103f83adf9", "exact": "5ac70468a1ff49b1f151821dbe0eca7891b489a9bf1d79fdccc9d5b5ae5aaa88", "function": true, "tokens": 67}, {"start_line": 12, "end_line": 16, "key": "c9ecd1f79a5b08bf7189730d7c870294eef0cb13486170d96ea2920cf2240883", "exact": "d76be8212c4a8b09fe95c695731c1a9eb5b08066950528179594433b2d9b08ef", "function": false, "tokens": 27}, {"start_line": 13, "end_line": 15, "key": "9933b62a0659025cd0de0aa83835d5a728346a41ce9c195e93d94248ec2244c6", "exact": "c9741399823f3d154a7391b073079a25779bb93276dd5c045decb0745f7855b5", "function": false, "tokens": 16}, {"start_line": 17, "end_line": 24, "key": "910acd971a3b95672e190cda4d1f001982a2c662befda5d29c78eea823dded5e", "exact": "5fd57fdbb131aeeb4b0acf809c732e22011fc160fcda92752a9c44b38db6c541", "function": false, "tokens": 20}, {"start_line": 27, "end_line": 41, "key": "3e6495eecdb8