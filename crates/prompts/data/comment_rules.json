    {
      "language": "javascript",
      "runs": {
        "line": "^//",
        "block": "^/\\*",
        "doc": "^/\\*\\*",
        "head": "first_line",
        "directive": "^(?:///\\s*<|//\\s*@(?:flow|jsx|jsxImportSource|jsxRuntime|vitest-environment|jest-environment)\\b)",
        "banner": "^(?://|/\\*)\\s*(?:[-=~*#/]{4,}|[-=~*#]{3,}.*[-=~*#]{3,})\\s*(?:\\*/)?\\s*$"
      },
      "docs": {
        "style": "jsdoc",
        "tags": "(?m)^\\s*\\*?\\s*@(param|arg|argument|returns?|throws)\\b",
        "aliases": {"arg": "param", "argument": "param", "return": "returns"}
      },
      "suppressions": {
        "on": "comment",
        "pattern": "^(?://|/\\*)\\s*(?:eslint-disable|@ts-ignore|@ts-nocheck|@ts-expect-error|prettier-ignore|biome-ignore)"
      }
    },
    {
      "language": "json",
      "runs": {"gap": "data_language"},
      "docs": {"gap": "data_language"},
      "suppressions": {"gap": "data_language"}
    },
    {
      "language": "kotlin",
      "runs": {"gap": "tier_two"},
      "docs": {"gap": "tier_two"},
