    },
    {
      "language": "python",
      "runs": {
        "line": "^#",
        "block": null,
        "doc": null,
        "head": "comment",
        "directive": "^#\\s*(?:!|-\\*-|type:|pragma:|fmt:|isort:)",
        "banner": "^#\\s*(?:[-=~*#]{4,}|[-=~*#]{3,}.*[-=~*#]{3,})\\s*$"
      },
      "docs": {
        "style": "docstring",
        "private": "^_",
        "sections": "(?m)^\\s*(?:Args|Arguments|Parameters|Returns|Yields|Raises):\\s*$"
      },
      "suppressions": {
        "on": "comment",
        "pattern": "#\\s*(?:noqa\\b|nosec\\b|type:\\s*ignore\\b|(?:pylint|pyright|mypy|ruff):\\s*(?:disable|ignore|noqa))"
      }
    },
    {
      "language": "ruby",
      "runs": {"gap": "doc_attachment"},
      "docs": {"gap": "doc_attachment"},
      "suppressions": {"gap": "doc_attachment"}
    },
    {
      "language": "rust",
      "runs": {
        "line": "^//",
        "block": "^/\\*",
        "doc": null,
        "head": "first_line",
        "directive": null,
        "banner": "^(?://[/!]?|/\\*[*!]?)\\s*(?:[-=~*#/]{4,}|[-=~*#]{3,}.*[-=~*#]{3,})\\s*(?:\\*/)?\\s*$"
      },
      "docs": {
        "style": "rust_items",
        "item": "^(?P<visibility>pub\\b(?:\\s*\\([^)]*\\))?)?\\s*(?:(?:default|const|async|unsafe|safe|extern)\\s+)*(?P<kind>fn|struct|enum|union|trait|type|const|static|mod|use|impl|macro_rules!)?\\s*(?P<name>\\$?(?:r#)?\\w+)?",
        "public": "pub",
        "export": "macro_export",
        "facing": "\\bderive\\s*\\([^)]*\\b(?:Parser|Subcommand|Args|ValueEnum|JsonSchema)\\b|#\\[\\s*(?:pyclass|pymethods|pyfunction|pymodule|tool|tool_router)\\b",
        "sections": "(?m)^\\s*#\\s+(?:Arguments|Args|Parameters|Params|Returns?)\\s*$"
      },
      "suppressions": {
        "on": "attribute",
        "pattern": "^(?:(?:allow|expect)\\s*\\(|rustfmt::skip\\b|cfg_attr\\s*\\(.*\\b(?:allow|expect)\\s*\\()"
      }
    },
