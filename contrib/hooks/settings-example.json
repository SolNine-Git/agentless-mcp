{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/agentless-mcp hook read-card",
            "timeout": 9
          }
        ]
      },
      {
        "matcher": "mcp__agentless__trace",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/agentless-mcp hook ledger-mark",
            "timeout": 6
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/agentless-mcp hook brief-record",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/agentless-mcp hook erosion",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/agentless-mcp hook subagent-map",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/agentless-mcp hook prompt-map",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/agentless-mcp hook ledger-reset",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
