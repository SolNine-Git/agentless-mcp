# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Secrets (PyPI token lives in .env as PYPI_API_KEY)
.env

# uv / virtualenv
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/

# Claude Code config is global (~/.claude); the local .claude holds the
# machine-generated PostToolUse quality-gate hook and settings, regenerated by
# repo-setup/setup-quality-gates.sh --hooks. Mirrors mcp-local.
.claude/

# setup-quality-gates.sh backups
.quality-gates-backup/

# Coverage data. `parallel = true` writes one file per process (.coverage.host.pid.rand)
# and `coverage combine` merges them into .coverage; none of it is a source artifact.
.coverage
.coverage.*
htmlcov/

# CI test log (tee target for the skip-ceiling check)
pytest-output.txt
